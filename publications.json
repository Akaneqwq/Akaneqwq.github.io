    {
        "group": "first-author",
        "title": "Pair2Point: Distilling Pairwise Reasoning into Pointwise Rewards for High-Quality Text-to-Image Generation",
        "authors": [
            {
                "name": "Qian Wang",
                "self": true
            },
            {
                "name": "Xinhang Leng"
            },
            {
                "name": "Yinan Li"
            },
            {
                "name": "Sujie Hu"
            },
            {
                "name": "Huaisong Zhang"
            },
            {
                "name": "Chen Li"
            },
            {
                "name": "Jian Zhang",
                "link": "https://jianzhang.tech/"
            }
        ],
        "venue": "AAAI, 2027 (under review)",
        "links": [],
        "desc": "We propose Pair2Point, a two-stage training paradigm for text-to-image reward models. It first trains a pairwise reasoning model and then distills it into an efficient pointwise scoring model, addressing the low efficiency of pairwise comparisons and the instability of pointwise scoring. We also construct a corresponding benchmark, a preference dataset, and a pointwise dataset."
    },
    {
        "group": "first-author",
        "title": "AgentKE: Agentic Knowledge Editing for Diffusion Transformers",
        "authors": [
            {
                "name": "Qian Wang",
                "self": true
            },
            {
                "name": "Shuyu Wang"
            },
            {
                "name": "Zhile Guan"
            },
            {
                "name": "Xinhua Cheng",
                "link": "https://cxh0519.github.io/"
            },
            {
                "name": "Xiandong Meng"
            },
            {
                "name": "Jian Zhang",
                "link": "https://jianzhang.tech/"
            }
        ],
        "venue": "AAAI, 2027 (under review)",
        "links": [],
        "desc": "We propose AgentKE, a knowledge editing framework for text-to-image diffusion transformers. It leverages a VLM to decompose natural language intents and generate corresponding protection sets, then edits the parameters of linear projection layers in the null space of the protection sets to update or modify knowledge, with automatic reflection to improve the editing results."
    },
